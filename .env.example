# ===========================
# Local Development (.env)
# ===========================

# Database credentials (used by docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres

# JWT secret (min 256 bits / 32+ chars)
JWT_SECRET=JyotishJourneySecretKeyForJWTTokenGeneration2024MustBe256BitsLong!

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/users/oauth2/callback

# Frontend URL (for OAuth callback redirect)
APP_FRONTEND_URL=http://localhost:4200

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ===========================
# Render Deployment
# ===========================
# Set these as environment variables on each Render service.
# See DEPLOY.md for which service needs which variable.
#
# SPRING_DATASOURCE_URL=postgres://user:pass@host:5432/dbname
# SPRING_REDIS_HOST=red-xxxxx
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=https://jj-discovery.onrender.com/eureka/
# RENDER_API_URL=https://jj-gateway.onrender.com/api
# RENDER_GATEWAY_URL=https://jj-gateway.onrender.com
